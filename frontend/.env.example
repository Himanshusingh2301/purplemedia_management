# Leave empty when frontend is served by the same backend (recommended for Railway monorepo)
# API requests use relative /api paths by default

# Only needed if API runs on a different domain:
# VITE_API_URL=https://your-api.example.com/api

# Socket URL — leave empty in production when same origin as the app
# VITE_SOCKET_URL=

# Local development (optional — Vite proxy handles /api)
# VITE_SOCKET_URL=http://localhost:5000
