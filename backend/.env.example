# Copy to .env locally — on Render, set these in the dashboard (Environment tab)

MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/taskmanager
JWT_SECRET=use-a-long-random-string-at-least-32-characters
ADMIN_REGISTRATION_SECRET=admin123
NODE_ENV=production
CLIENT_URL=https://your-frontend.vercel.app
CORS_ORIGIN=https://your-frontend.vercel.app
