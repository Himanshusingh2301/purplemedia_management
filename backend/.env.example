# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb://localhost:27017/taskmanager

# Strong random string for JWT signing (required in production)
JWT_SECRET=your-strong-random-secret-here

# Secret required when registering as Admin
ADMIN_REGISTRATION_SECRET=your-admin-code-here

# Server port (Railway/Heroku set PORT automatically)
PORT=5000

# Frontend URL for password-reset links (optional)
CLIENT_URL=http://localhost:5173

# Comma-separated allowed origins for CORS (optional, production)
# CORS_ORIGIN=https://your-app.up.railway.app

# Set on your host (Railway, Render, etc.)
# NODE_ENV=production
